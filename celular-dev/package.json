{
  "name": "celular-dev",
  "version": "0.5.0",
  "description": "Probá tu sitio en tu celular Android real desde Windows, Mac o Linux: lo abre por cable, lo recarga al guardar, te muestra sus errores explicados y su pantalla en vivo.",
  "type": "module",
  "bin": {
    "celular-dev": "bin/celular.mjs",
    "celular": "bin/celular.mjs"
  },
  "files": [
    "bin",
    "src",
    "marca",
    "ejemplo"
  ],
  "scripts": {
    "test": "node --test --test-force-exit --test-timeout=60000",
    "start": "node bin/celular.mjs",
    "empaquetar": "node scripts/empaquetar.mjs",
    "icono": "node scripts/generar-icono.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "android",
    "adb",
    "celular",
    "mobile",
    "live-reload",
    "devtools",
    "debug",
    "screen-mirror",
    "i18n"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SantiagoNardini/celular-dev.git"
  },
  "homepage": "https://github.com/SantiagoNardini/celular-dev#readme",
  "bugs": {
    "url": "https://github.com/SantiagoNardini/celular-dev/issues"
  },
  "author": "Santiago Nardini"
}
